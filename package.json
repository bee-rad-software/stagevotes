{
  "name": "stagevotes",
  "version": "0.1.0",
  "private": true,
  "main": "electron-karafun-display.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "desktop": "electron electron-karafun-display.js",
    "desktop:pack": "electron-builder --dir",
    "desktop:dist": "electron-builder",
    "desktop:dist:win": "electron-builder --win --x64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "latest",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.42.2",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "lucide-react": "^1.23.0",
    "next": "latest",
    "qrcode.react": "^4.2.0",
    "react": "latest",
    "react-dom": "latest",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "typescript": "latest"
  },
  "build": {
    "appId": "com.stagevotes.host",
    "productName": "StageVotes",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-karafun-display.js",
      "electron-preload.js",
      "public/icon-512.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "forceCodeSigning": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "azureSignOptions": {
        "publisherName": "CN=STAGE VOTES LLC, O=STAGE VOTES LLC, L=Rogers, S=Arkansas, C=US",
        "endpoint": "https://eus.codesigning.azure.net/",
        "codeSigningAccountName": "stagevotes-signing",
        "certificateProfileName": "stagevotes-public-trust"
      }
    }
  }
}
